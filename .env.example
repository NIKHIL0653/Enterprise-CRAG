# ---------------------------------------------------------------------------
# WorkspaceRAG Environment Template
# ---------------------------------------------------------------------------
# Copy this file to .env and populate with your real API credentials:
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Application Settings
APP_NAME=WorkspaceRAG
DEBUG=false
LOG_LEVEL=INFO

# Google Workspace Integration
# Path to service account JSON key with Google Drive API access
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service_account.json
# Folder ID of the Google Drive folder to synchronize
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_here

# Google Gemini (LLM & Embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=models/gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# PostgreSQL 16 + pgvector Database
# Local Docker Compose:
DATABASE_URL=postgresql://raguser:ragpassword@localhost:5432/workspace_rag
# Cloud Supabase (alternative):
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require

# Cohere Cross-Encoder Reranking
COHERE_API_KEY=your_cohere_api_key_here

# Langfuse Observability & Tracing
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# Retrieval & Caching Hyperparameters
TOP_K_RETRIEVAL=15
TOP_K_RERANK=5
RRF_K=60
RELEVANCE_THRESHOLD=0.5
SYNC_POLL_INTERVAL_SECONDS=60
