# ---------------------------------------------------------------------------
# WorkspaceRAG Test Environment Configuration Profile
# ---------------------------------------------------------------------------
# This file is committed to source control for CI and automated testing.
# It contains non-sensitive mock configuration allowing unit and integration
# test suites to execute in isolated CI environments without live API keys.
# ---------------------------------------------------------------------------

APP_NAME=WorkspaceRAG
DEBUG=true
LOG_LEVEL=INFO

# Mock Google Workspace
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/service_account.json
GOOGLE_DRIVE_FOLDER_ID=test_folder_id

# Mock Gemini
GEMINI_API_KEY=test_gemini_api_key_for_testing_purposes
GEMINI_MODEL=models/gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Mock PostgreSQL
DATABASE_URL=postgresql://test:test@localhost:5432/workspace_rag_test

# Mock Cohere
COHERE_API_KEY=test_cohere_api_key_for_testing_purposes

# Mock Langfuse
LANGFUSE_SECRET_KEY=test_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=test_langfuse_public_key
LANGFUSE_HOST=https://cloud.langfuse.com

# Retrieval Tuning Defaults
TOP_K_RETRIEVAL=15
TOP_K_RERANK=5
RRF_K=60
RELEVANCE_THRESHOLD=0.5
SYNC_POLL_INTERVAL_SECONDS=60
